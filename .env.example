# Copy to `.env` and fill in values. Never commit `.env`.

# --- LLM (Phase 2+) — dual providers ---
# Groq → theme classification / generation
# Get a key at https://console.groq.com/
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Free-tier style budgets (throttle in src/agent/rate_limit.py)
# GROQ_RPM=30
# GROQ_TPM=8000
# GROQ_RPD=1000
# GROQ_TPD=200000
# GROQ_BATCH_SIZE=8
# Hybrid theme labeling (bare-minimum Groq tokens):
# keyword-confident reviews skip Groq; only ambiguous ones are labeled.
# GROQ_MAX_LLM_LABEL=40          # max ambiguous reviews → Groq (0 = no Groq themes)
# GROQ_HEURISTIC_MIN_SCORE=1     # keyword hits to treat as confident (skip Groq)

# Gemini → quotes, actions, pulse markdown (reporting)
# Get a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# Or use:
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash

# --- Pulse delivery (Phase 3+) ---
# Gmail draft recipient (self or alias)
PULSE_DRAFT_RECIPIENT=

# Optional display name in email subject / doc title prefix
# PULSE_PRODUCT_NAME=Groww

# Existing Google Doc id for weekly appends (required for Railway MCP-Server-1).
# Create a Doc once in Drive; copy id from:
#   https://docs.google.com/document/d/<PULSE_DOC_ID>/edit
# MCP-Server-1 only exposes google_docs_append_content (no create-doc tool).
PULSE_DOC_ID=

# --- MCP (Phase 3+) — FallenOne1701/MCP-Server-1 on Railway ---
# Repo: https://github.com/FallenOne1701/MCP-Server-1
# Public URL (HTTPS :443). Railway container PORT (e.g. 8080) is internal — do not put :8080 here.
MCP_TRANSPORT=http
MCP_URL=https://mcp-server-1-production.up.railway.app/mcp
# Same value as Railway → Variables → MCP_API_KEY (Bearer for /mcp)
MCP_API_KEY=

# Tool names (defaults match MCP-Server-1; do not use gmail_send_email)
MCP_DOCS_CREATE_TOOL=google_docs_append_content
MCP_GMAIL_DRAFT_TOOL=gmail_create_draft

# Offline stub fallback (no Google / no Railway):
# MCP_TRANSPORT=inprocess

# MCP_CONFIG=mcp.json
# MCP_DOCS_SERVER=pulse
# MCP_GMAIL_SERVER=pulse

# --- Pipeline defaults (Phase 1+) ---
# REVIEW_WINDOW_WEEKS=8
# APP_PACKAGE_ID=com.nextbillion.groww

# --- Weekly scheduler (Phase 6) ---
# Monday 08:00 IST. Task Scheduler uses the PC clock — set Windows TZ to IST.
# PULSE_SCHEDULE_WEEKDAY=0
# PULSE_SCHEDULE_HOUR=8
# PULSE_SCHEDULE_MINUTE=0
# Safer unattended default (heuristic avoids Groq/Gemini quota):
# PULSE_WEEKLY_MODE=heuristic
# Opt-in inbox send (default is Gmail draft only — leave unset for the assignment):
# PULSE_EMAIL_SEND=false
# MCP_GMAIL_SEND_TOOL=gmail_send_email

# --- Optional tracing (Phase 5) ---
# Local file traces always write to output/traces/.
# LangSmith (optional):
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT=groww-weekly-pulse
