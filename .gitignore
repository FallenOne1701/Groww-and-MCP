# Run artifacts that include draft recipient / local disk paths
output/**/run.json
output/**/delivery.json

# Optional: keep cleaned/output out of git if they contain run artifacts
# Uncomment if you prefer not to commit generated files:
# data/cleaned/*
# !data/cleaned/.gitkeep
# output/*
# !output/.gitkeep

# LangSmith / local traces
.langsmith/
*.trace.json
output/traces/
output/**/traces/

# MCP local config / stub delivery artifacts
mcp.json
output/mcp/

# Phase 6 weekly job lock
output/weekly_job.lock
output/weekly_job.json
